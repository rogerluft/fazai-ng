[Unit]
Description=FazAI Web Interface (Next.js)
Documentation=https://github.com/rogerluft/fazai-ng
After=network.target qdrant.service
Wants=qdrant.service

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/fazai/web

# Ambiente de producao
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/usr/local/bin

# Carregar variaveis de /etc/fazai/fazai.conf
# WEB_HOST e WEB_PORT sao lidos pelo Next.js via config-loader.ts
EnvironmentFile=-/etc/fazai/fazai.conf

# Porta padrao 3000 (pode ser sobrescrita por WEB_PORT em fazai.conf)
Environment=PORT=3000

ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fazai-web

# Security hardening
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
