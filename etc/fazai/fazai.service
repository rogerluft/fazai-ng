[Unit]
Description=FazAI v3.1-beta - Terminal Admin Linux Inteligente
Documentation=https://github.com/rogerluft/fazai-ng
After=network.target qdrant.service
Wants=qdrant.service

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/fazai/data
EnvironmentFile=-/etc/fazai/fazai.conf
EnvironmentFile=-/home/%i/.config/fazai/fazai.conf
ExecStart=/usr/local/bin/fazai --cli
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fazai

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/fazai/data /var/log/fazai

[Install]
WantedBy=multi-user.target
