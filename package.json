{
  "name": "fazai",
  "version": "3.1.0-beta",
  "author": "Roger Luft (VeilWalker) <roger@webstorage.com.br> (fork from Mandark by Hrishi Olickel)",
  "description": "Administrador Linux Inteligente com IA - Gerenciador de sistemas Linux com modelos híbridos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seu-usuario/fazai.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@github/copilot": "^0.0.359",
    "@github/copilot-language-server-linux-x64": "^1.396.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "chalk": "4.1.2",
    "inquirer": "^12.10.0",
    "oboe": "^2.1.7",
    "openai": "^6.3.0",
    "ora": "5.4.1",
    "zod": "^4.1.12"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/postbuild.js",
    "dev": "tsx src/app.ts",
    "start": "node dist/app.cjs",
    "deploy": "npm run build && bash scripts/deploy.sh",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "./dist/app.cjs",
  "bin": {
    "fazai": "bin/fazai.js"
  },
  "engineStrict": true,
  "devDependencies": {
    "@swc/core": "^1.7.0",
    "@types/node": "^24.10.1",
    "@vitest/ui": "^4.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.3",
    "vitest": "^4.0.9"
  }
}
