{
  "name": "fazai",
  "version": "3.14.8",
  "author": "Roger Luft (VeilWalker) <roger@rogerluft.com.br>",
  "description": "Administrador Linux Inteligente com IA - Gerenciador de sistemas Linux com modelos híbridos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seu-usuario/fazai.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@crawlee/playwright": "^3.15.3",
    "@genaiscript/api": "^2.5.1",
    "@genaiscript/core": "^2.5.1",
    "@genaiscript/runtime": "^2.5.1",
    "@github/copilot": "^0.0.359",
    "@github/copilot-language-server-linux-x64": "^1.396.0",
    "@google/generative-ai": "^0.24.1",
    "@inquirer/prompts": "^7.10.1",
    "@octokit/rest": "^21.0.2",
    "@qdrant/js-client-rest": "^1.16.2",
    "@types/ws": "^8.18.1",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.6.2",
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "claude-code-plugins": "^1.0.3",
    "cli-table3": "^0.6.5",
    "crawlee": "^3.15.3",
    "express": "^5.2.1",
    "genaiscript": "^2.5.1",
    "gradient-string": "^3.0.0",
    "inquirer": "^12.10.0",
    "oboe": "^2.1.7",
    "openai": "^6.3.0",
    "ora": "5.4.1",
    "p-queue": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.57.0",
    "robots-parser": "^3.0.1",
    "terminal-kit": "^3.1.2",
    "undici": "^5.28.4",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.1.12"
  },
  "scripts": {
    "prepare": "husky",
    "build": "bash scripts/setup-env.sh && tsup",
    "build:safe": "bash scripts/setup-env.sh && tsup",
    "build:full": "bash scripts/setup-env.sh && npm test && tsup",
    "build:all": "npm run build && npm run build:web",
    "build:web": "cd web && npm run build",
    "postbuild": "node scripts/postbuild.js",
    "gen:completion": "node scripts/generate-completions.js",
    "dev": "tsx src/app.ts",
    "dev:web": "cd web && npm run dev",
    "start": "node dist/app.cjs",
    "start:web": "cd web && npm run start",
    "deploy": "npm run build && bash scripts/deploy.sh",
    "deploy:all": "npm run build:all && bash scripts/deploy.sh",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:real": "bash tests/real-world-exec.sh",
    "test:full": "vitest run && bash tests/real-world-exec.sh",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "./dist/app.js",
  "bin": {
    "fazai": "bin/fazai.js"
  },
  "engineStrict": true,
  "devDependencies": {
    "@swc/core": "^1.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.3",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{ts,tsx}": "echo 'TypeScript files staged for commit'"
  }
}
