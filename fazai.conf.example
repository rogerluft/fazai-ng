# FazAI Configuration File
# Copy this file to fazai.conf and fill with your credentials

# =============================================================================
# MODEL CONFIGURATION (Flexible Model Selection)
# =============================================================================

# OpenRouter API Key (access 200+ models via single API)
# Get yours at: https://openrouter.ai/keys
# Free tier available: qwen/qwen3-coder:free (Qwen3 Coder 480B A35B)
OPENROUTER_API_KEY=your_openrouter_key_here

# Default model for general tasks
# Examples:
#   DEFAULT_MODEL=qwen/qwen3-coder:free        # Free via OpenRouter (480B A35B)
#   DEFAULT_MODEL=ollama/gptoss-20b            # Local model
DEFAULT_MODEL=qwen/qwen3-coder:free

# Complex reasoning tasks (optional - falls back to DEFAULT_MODEL)
# Use same model as default (Qwen3 Coder is powerful for complex tasks)
# COMPLEX_MODEL=qwen/qwen3-coder:free

# Fast/cheap tasks (optional - falls back to DEFAULT_MODEL)
# Use local Ollama for fastest response (no API latency)
FAST_MODEL=ollama/gptoss-20b

# Local model via Ollama (optional - for privacy)
LOCAL_MODEL=ollama/gptoss-20b
# LOCAL_MODEL=ollama/llama3.2

# Prefer local models when available (privacy mode)
# Set to true to use LOCAL_MODEL (gptoss-20b) first, fallback to OpenRouter
PREFER_LOCAL=false

# =============================================================================
# LEGACY API KEYS (Optional - Not Required for Current Setup)
# =============================================================================

# Anthropic Claude API Key (not available in current setup)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (not available in current setup)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# LOCAL MODELS
# =============================================================================

# Ollama Base URL (for local LLM)
# Default: http://localhost:11434
# Remote: http://192.168.0.101:11434
# Remote server example: http://192.168.0.101:11434
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://192.168.0.101:11434

# Available Ollama Models (comma-separated)
# These are the models you have running on your Ollama instance
OLLAMA_MODELS=gptoss-20b,llama3.2

# MCP Context7 integration (optional)
# Provide either an HTTP endpoint or a CLI command
# MCP_CONTEXT7_URL=https://context7.com/api/v1/search
# MCP_CONTEXT7_URL=http://localhost:7700/context7/search
# MCP_CONTEXT7_COMMAND=context7 --json --query "{query}"
# MCP_CONTEXT7_API_KEY=seu_token_opcional

# Web search fallback provider (currently DuckDuckGo)
# WEB_SEARCH_PROVIDER=duckduckgo

# Vector store integration (Qdrant or Milvus/Zilliz)
# VECTOR_PROVIDER=qdrant
# VECTOR_DIMENSION=1536
# VECTOR_DISTANCE=cosine
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=coloque_seu_token
# MILVUS_ADDRESS=localhost:19530
# MILVUS_USERNAME=root
# MILVUS_PASSWORD=Milvus
# MILVUS_SSL=false
# MILVUS_TOKEN=token_opcional_para_zilliz

# Disable research if running offline (set to true/1)
# FAZAI_DISABLE_RESEARCH=true

# Custom path for this config file (helpful for global installs)
# FAZAI_CONFIG_PATH=/etc/fazai/fazai.conf

# =============================================================================
# CLOUDFLARE INTEGRATION
# =============================================================================

# Cloudflare API Token (recommended - scoped permissions)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare API Key (legacy - global permissions)
# CLOUDFLARE_API_KEY=your_global_api_key
# CLOUDFLARE_EMAIL=your@email.com

# Cloudflare Account ID (optional - for account-level operations)
# CLOUDFLARE_ACCOUNT_ID=your_account_id

# =============================================================================
# GEMINI INTEGRATION (Future)
# =============================================================================

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key
