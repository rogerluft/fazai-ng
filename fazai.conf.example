# ============================================================================
# FazAI Configuration File
# ============================================================================
#
# LOCATION: /etc/fazai/fazai.conf (ONLY)
#
# IMPORTANT: Previous versions (< v3.5) supported ~/.config/fazai/fazai.conf
#            This is NO LONGER SUPPORTED to prevent config conflicts.
#            All configuration MUST be in /etc/fazai/fazai.conf
#
# INSTALLATION:
#   sudo cp fazai.conf.example /etc/fazai/fazai.conf
#   sudo nano /etc/fazai/fazai.conf  # Edit with your API keys
#   sudo chmod 644 /etc/fazai/fazai.conf
#
# PERMISSIONS:
#   Owner: root:root (or your user for development)
#   Permissions: 644 (readable by all, writable by owner)
#
# MIGRATION FROM OLD VERSION:
#   If you have ~/.config/fazai/fazai.conf, move it:
#   sudo cp ~/.config/fazai/fazai.conf /etc/fazai/fazai.conf
#   rm -rf ~/.config/fazai/
#
# ============================================================================

# =============================================================================
# MODEL CONFIGURATION (Config-Driven Architecture)
# =============================================================================
#
# IMPORTANT RULES:
# 1. Use EXACT model names (no nicknames, no aliases)
# 2. Order matters: First model in list = default for that provider
# 3. Maximum 3 models per provider (organization constraint)
# 4. Models are loaded in the order you specify
#
# Format: MODELS_PROVIDER=model1,model2,model3
#
# WHY NO NICKNAMES?
# - Eliminates ambiguity (one model = one name)
# - Easier to debug (name in config = name in logs)
# - Follows provider documentation exactly
# - Simplifies maintenance and updates
#
# =============================================================================

# -----------------------------------------------------------------------------
# OLLAMA (Local Models - Recommended for Privacy & Speed)
# -----------------------------------------------------------------------------
# These models run locally on your OLLAMA_BASE_URL instance
# Recommended: 1 small model (fast) + 1 medium model (capable)
#
# Popular choices:
#   - tinyllama:1b      → Ultra-fast, minimal resources (1GB VRAM)
#   - qwen2.5:7b        → Best balance (8GB VRAM)
#   - llama3.2:latest   → Meta's latest (8GB VRAM)
#
# MODELS_OLLAMA=tinyllama:1b,qwen2.5:7b
MODELS_OLLAMA=qwen2.5:7b,tinyllama:1b

# -----------------------------------------------------------------------------
# OPENROUTER (Cloud Models - Free Tier Available)
# -----------------------------------------------------------------------------
# Access 200+ models through one API key
# Free models include: qwen/qwen3-coder:free, google/gemini-2.0-flash-exp:free
#
# Get API key: https://openrouter.ai/keys
#
# Popular free choices:
#   - qwen/qwen3-coder:free           → Excellent for coding (FREE)
#   - google/gemini-2.0-flash-exp:free → Fast general purpose (FREE)
#   - meta-llama/llama-3.3-70b         → Powerful reasoning (paid)
#
MODELS_OPENROUTER=qwen/qwen3-coder:free,google/gemini-2.0-flash-exp:free
# OPENROUTER_API_KEY=sk-or-v1-xxxxx

# -----------------------------------------------------------------------------
# PERPLEXITY (Search-Enabled AI - Online Research)
# -----------------------------------------------------------------------------
# Sonar models combine real-time web search with LLM reasoning
# Perfect for: troubleshooting, research, up-to-date information
#
# Get API key: https://www.perplexity.ai/settings/api
#
# Available models:
#   - llama-3-sonar-small-32k-online  → Fast, cost-effective (DEFAULT)
#   - llama-3-sonar-large-32k-online  → Higher quality reasoning
#   - llama-3-sonar-large-32k-reasoning → Advanced reasoning
#
MODELS_PERPLEXITY=llama-3-sonar-small-32k-online,llama-3-sonar-large-32k-online
# PERPLEXITY_API_KEY=pplx-xxxxx

# -----------------------------------------------------------------------------
# GOOGLE GEMINI (Google's AI Models)
# -----------------------------------------------------------------------------
# Native Google Gemini API (not via OpenRouter)
# Free tier: 15 requests/min, 1500 requests/day
#
# Get API key: https://makersuite.google.com/app/apikey
#
# Available models:
#   - gemini-2.5-flash      → Fast & balanced (DEFAULT)
#   - gemini-2.5-pro        → Deep reasoning (slower)
#   - gemini-2.5-flash-lite → Quick tasks (fastest)
#
# MODELS_GOOGLE=gemini-2.5-flash,gemini-2.5-pro
# GEMINI_API_KEY=AIzaSyxxxxx

# -----------------------------------------------------------------------------
# OPENAI (GPT Models - Optional, Requires API Key)
# -----------------------------------------------------------------------------
# OpenAI's GPT models (commercial service)
#
# Get API key: https://platform.openai.com/api-keys
#
# Available models:
#   - gpt-4o-mini → Fast & cheap (best value)
#   - gpt-4o      → Most capable (expensive)
#   - gpt-4-turbo → Previous generation
#
# MODELS_OPENAI=gpt-4o-mini,gpt-4o
# OPENAI_API_KEY=sk-xxxxx

# -----------------------------------------------------------------------------
# ANTHROPIC CLAUDE (Optional, Requires API Key)
# -----------------------------------------------------------------------------
# Anthropic's Claude models (commercial service)
#
# Get API key: https://console.anthropic.com/
#
# Available models:
#   - claude-3-5-sonnet-latest  → Most capable (expensive)
#   - claude-3-haiku-20240307   → Fast & efficient (cheaper)
#
# MODELS_ANTHROPIC=claude-3-5-sonnet-latest,claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# =============================================================================
# CLOUDFLARE GEMINI INTEGRATION
# =============================================================================
#
# Use Google's Gemini models via Cloudflare Workers
# Based on: https://github.com/GewoonJaap/gemini-cli-openai
#
# Supported Models:
# - gemini-2.5-pro (1M context, 65K max tokens)
# - gemini-2.5-flash (1M context, 65K max tokens)
# - gemini-2.5-flash-lite (1M context, 65K max tokens)
#
# Setup:
# 1. Deploy gemini-cli-openai to your Cloudflare Worker
# 2. Set GEMINI_WORKER_URL to your Worker endpoint
# 3. (Optional) Set OPENAI_API_KEY for authentication

# Cloudflare Worker URL (Gemini endpoint)
# GEMINI_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# (Optional) API Key for authentication
# OPENAI_API_KEY=your_optional_api_key

# =============================================================================
# JULES API (Google AI Coding Agent)
# =============================================================================
#
# Jules is Google's AI coding agent for autonomous code changes.
# The API allows programmatic access to create sessions, send tasks, and monitor progress.
#
# Get your API key at: https://jules.google/settings (API Keys section)
# Documentation: https://jules.google/docs/api/reference/
#
# Requirements:
# - Jules GitHub App must be installed on your repositories
# - Maximum 3 API keys per account
#
# JULES_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================
#
# Authenticate with GitHub for repository operations
# Create a Personal Access Token: https://github.com/settings/tokens
#
# Scopes needed:
# - repo (full control of private repositories)
# - read:user (read user profile data)
# - public_repo (access public repositories)

# GitHub Personal Access Token
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# =============================================================================
# LOCAL MODELS (OLLAMA)
# =============================================================================

# Ollama Base URL
# Local: http://localhost:11434
# Remote: http://192.168.0.101:11434
OLLAMA_BASE_URL=http://192.168.0.101:11434

# MCP Context7 integration (optional)
# Provide either an HTTP endpoint or a CLI command
# MCP_CONTEXT7_URL=https://context7.com/api/v1/search
# MCP_CONTEXT7_URL=http://localhost:7700/context7/search
# MCP_CONTEXT7_COMMAND=context7 --json --query "{query}"
# MCP_CONTEXT7_API_KEY=seu_token_opcional

# Web search fallback provider (currently DuckDuckGo)
# WEB_SEARCH_PROVIDER=duckduckgo

# Vector store integration (Qdrant or Milvus/Zilliz)
# VECTOR_PROVIDER=qdrant
# VECTOR_DIMENSION=1536
# VECTOR_DISTANCE=cosine
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=coloque_seu_token
# MILVUS_ADDRESS=localhost:19530
# MILVUS_USERNAME=root
# MILVUS_PASSWORD=Milvus
# MILVUS_SSL=false
# MILVUS_TOKEN=token_opcional_para_zilliz

# Disable research if running offline (set to true/1)
# FAZAI_DISABLE_RESEARCH=true

# Custom path for this config file (helpful for global installs)
# FAZAI_CONFIG_PATH=/etc/fazai/fazai.conf

# FAZAI_MAX_RETRIES=3


# =============================================================================
# PREVIEW & EXPERIMENTAL FEATURES
# =============================================================================
#
# Enable pre-release or unstable features. Use with caution.
#
# ENABLE_PREVIEW_FEATURES=true
ENABLE_PREVIEW_FEATURES=false

# =============================================================================
# CLOUDFLARE INTEGRATION
# =============================================================================

# Cloudflare API Token (recommended - scoped permissions)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare API Key (legacy - global permissions)
# CLOUDFLARE_API_KEY=your_global_api_key
# CLOUDFLARE_EMAIL=your@email.com

# Cloudflare Account ID (optional - for account-level operations)
# CLOUDFLARE_ACCOUNT_ID=your_account_id

# =============================================================================
# GEMINI INTEGRATION (Future)
# =============================================================================

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key

# =============================================================================
# SPAMEXPERTS INTEGRATION
# =============================================================================

# SpamExperts API Configuration
# URL: Base URL for SpamExperts API (default: https://api.antispamcloud.com/)
# SPAMEXPERTS_API_URL=https://api.antispamcloud.com/

# Authentication Method 1: API Key (recommended)
# SPAMEXPERTS_API_KEY=your_api_key_here

# Authentication Method 2: Username/Password (legacy)
# SPAMEXPERTS_USERNAME=your_username
# SPAMEXPERTS_PASSWORD=your_password

# =============================================================================
# OPNSENSE INTEGRATION
# =============================================================================

# OPNsense API Configuration
# URL: Base URL for OPNsense API (e.g., https://192.168.1.1)
# OPNSENSE_API_URL=https://192.168.1.1

# API Key and Secret
# Create at: System > Access > Users > [User] > API Keys
# OPNSENSE_API_KEY=your_api_key
# OPNSENSE_API_SECRET=your_api_secret

# SSL Verification
# Set to false if using self-signed certificates
# OPNSENSE_SSL_VERIFY=false

# =============================================================================
# WEB INTERFACE - Configuracao da Interface Web FazAI
# =============================================================================
#
# A interface web permite gerenciar integracoes (Cloudflare, SpamExperts, OPNsense)
# e monitorar o sistema FazAI atraves de um navegador.
#
# Porta padrao: 3000
# URL de acesso: http://localhost:3000 ou http://<seu-ip>:3000
#

# Host para escuta do servidor web
# 0.0.0.0 = escuta em todas as interfaces (acesso remoto habilitado)
# 127.0.0.1 = apenas localhost (acesso local apenas)
# Padrao: 0.0.0.0
WEB_HOST=0.0.0.0

# Porta do servidor web Next.js
# Padrao: 3000
WEB_PORT=3000

# Credenciais de acesso a interface web (HTTP Basic Auth)
# IMPORTANTE: Troque as credenciais padrao em producao!
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=fazai123
