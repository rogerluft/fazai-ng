#!/bin/sh
# FazAI TDD Enforcer - Bloqueia commits com testes quebrados
# Mantido por: Roger Luft (VeilWalker)
# v3.12.0 - Consolidação P0

# Skip in non-interactive (automated/CI) environments
if [ ! -t 1 ]; then
  exit 0
fi

echo ""
echo "🧪 FazAI TDD Enforcer: Executando suite completa de testes..."
echo ""

# Executa TODOS os testes (máxima segurança)
npm test

# Captura o código de saída
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║  ❌ COMMIT BLOQUEADO: Testes falharam!                     ║"
    echo "║                                                            ║"
    echo "║  Corrija os testes antes de fazer commit.                  ║"
    echo "║  Execute 'npm test' para ver detalhes.                     ║"
    echo "║                                                            ║"
    echo "║  Bypass emergencial: git commit --no-verify                ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  ✅ Todos os testes passaram! Commit permitido.            ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""
