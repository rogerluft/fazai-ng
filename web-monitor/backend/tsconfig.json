{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@fazai/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*", "../../src/cloudflare-manager.ts", "../../src/spamexperts-manager.ts", "../../src/opnsense-manager.ts", "../../src/config.ts"],
  "exclude": ["node_modules", "dist"]
}
