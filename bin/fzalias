#!/bin/bash
# =============================================================================
# fzalias - Wrapper para 'fazai alias' com source automático
# =============================================================================
# Este script chama 'fazai alias' e depois faz source do arquivo de aliases
# para disponibilizar imediatamente na sessão atual.
#
# Uso:
#   fzalias ll 'ls -lah --color=auto'     # Cria alias
#   fzalias list                          # Lista aliases
#   fzalias remove ll                     # Remove alias
# =============================================================================

ALIAS_FILE="/etc/fazai/fzalias"

# Verifica se fazai está instalado
if ! command -v fazai >/dev/null 2>&1; then
    echo "✗ Error: 'fazai' command not found in PATH" >&2
    echo "Please install FazAI first: https://github.com/rogerluft/fazai-ng" >&2
    exit 1
fi

# Executa fazai alias
fazai alias "$@"
exit_code=$?

# Se criou/removeu alias com sucesso, faz source
if [[ $exit_code -eq 0 && -f "$ALIAS_FILE" ]]; then
    # Só faz source se não for comandos de leitura
    case "${1:-}" in
        list|ls|show|--help|-h)
            # Comandos de leitura, não precisa source
            ;;
        *)
            # Criação ou remoção, faz source
            source "$ALIAS_FILE" 2>/dev/null || true
            ;;
    esac
fi

exit $exit_code
