#!/usr/bin/env bash
#
# FazAI - Terminal Inteligente de Administração Linux
# Wrapper script que executa o CLI principal
#

# Run environment setup silently in the background to not clutter the command output
bash "$(dirname "$0")/../scripts/setup-env.sh" > /dev/null 2>&1 &

set -euo pipefail

# Detecta o diretório de instalação
INSTALL_DIR="${FAZAI_INSTALL_DIR:-/opt/fazai}"
APP_JS="${INSTALL_DIR}/dist/app.cjs"

# Verifica se a aplicação existe
if [[ ! -f "$APP_JS" ]]; then
    echo "❌ FazAI não encontrado em: $APP_JS" >&2
    echo "   Execute: sudo bash install.sh" >&2
    exit 1
fi

# Executa o CLI principal com todos os argumentos
exec node "$APP_JS" "$@"
