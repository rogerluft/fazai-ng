#!/usr/bin/env bash
#
# FazAI - Bootstrap mínimo (routing nativo em TypeScript)
#
# Este wrapper só faz o que o bash PRECISA fazer:
# 1. Carrega fazai.conf (env vars para o processo Node)
# 2. Limpa vars que conflitam com Agent SDK
# 3. Exec node bin/fazai.js (roteamento TypeScript nativo)
#

set -euo pipefail

# ─── Config ──────────────────────────────────────────────────
FAZAI_CONFIG="${FAZAI_CONFIG_PATH:-/etc/fazai/fazai.conf}"

if [[ -f "$FAZAI_CONFIG" ]]; then
    set -a
    source "$FAZAI_CONFIG"
    set +a
fi

# Agent SDK rejeita sessions aninhadas dentro do Claude Code
unset CLAUDECODE 2>/dev/null || true
# fazai.conf pode ter ANTHROPIC_API_KEY com token OAuth (sk-ant-oat01-*).
# O Agent SDK confunde com API key e rejeita. O injector usa OAuth via SDK.
unset ANTHROPIC_API_KEY 2>/dev/null || true

# ─── Resolve script dir (funciona com symlinks) ─────────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# ─── Delega para o entry point Node.js nativo ────────────────
sudo chmod 777 /home/rluft/fazai-ng/data -R
exec node "$SCRIPT_DIR/fazai.js" "$@"
