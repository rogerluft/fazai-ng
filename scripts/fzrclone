console = Console()

# ============================================================================
# ENUMS E DATACLASSES
# ============================================================================

class ConflictAction(Enum):
    KEEP_OLD = auto()
    REPLACE = auto()
    REPLACE_BACKUP = auto()
    SKIP = auto()

class FileStatus(Enum):
    PENDING = "⏳"
    SYNCING = "🔄"
    DONE = "✅"
    CONFLICT = "⚠️"
    SKIPPED = "⏭️"
    ERROR = "❌"
    DELETED = "🗑️"
    DELETING = "🔥"

@dataclass
class FileInfo:
    path: str
    size: int
    mtime: float
    is_dir: bool
    checksum: Optional[str] = None

    @property
    def size_human(self) -> str:
        size = self.size
        for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
            if size < 1024:
                return f"{size:.1f} {unit}"
            size /= 1024
        return f"{size:.1f} PB"

    @property
    def mtime_str(self) -> str:
        return datetime.fromtimestamp(self.mtime).strftime("%Y-%m-%d %H:%M:%S")

@dataclass
class SyncItem:
    rel_path: str
    source: Optional[FileInfo] = None
    dest: Optional[FileInfo] = None
    status: FileStatus = FileStatus.PENDING
    action: Optional[ConflictAction] = None

@dataclass
class SyncStats:
    total_files: int = 0
    synced: int = 0
    skipped: int = 0
    conflicts: int = 0
    errors: int = 0
    deleted: int = 0
    bytes_transferred: int = 0
    bytes_deleted: int = 0
    start_time: Optional[float] = None

    @property
    def elapsed(self) -> str:
        if not self.start_time:
            return "00:00:00"
        elapsed = time.time() - self.start_time
        hours, remainder = divmod(int(elapsed), 3600)
        minutes, seconds = divmod(remainder, 60)
        return f"{hours:02d}:{minutes:02d}:{seconds:02d}"

    @property
    def bytes_transferred_human(self) -> str:
        size = self.bytes_transferred
        for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
            if size < 1024:
                return f"{size:.1f} {unit}"
            size /= 1024
        return f"{size:.1f} PB"

    @property
    def bytes_deleted_human(self) -> str:
        size = self.bytes_deleted
        for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
            if size < 1024:
                return f"{size:.1f} {unit}"
            size /= 1024
        return f"{size:.1f} PB"

# ============================================================================
# CLASSE PRINCIPAL
# ============================================================================

class FzRclone:
    def __init__(
        self,
        source: str,
        dest: str,
        dry_run: bool = False,
        silent: bool = False,
        replace_all: bool = False,
        rollback: Optional[str] = None,
        schedule: Optional[int] = None,
        delete_dst: bool = False,
        bwlimit: Optional[str] = None
    ):
        self.source_arg = source
        self.dest_arg = dest
        self.dry_run = dry_run
        self.silent = silent
        self.replace_all = replace_all
        self.rollback = rollback
        self.schedule = schedule
        self.delete_dst = delete_dst
        self.bwlimit = bwlimit

        # Detectar quem é remote e quem é local
        self.direction = None       # "push" ou "pull"
        self.local_path = None      # Path local
        self.remote_path = None     # string remote (ex: gdriverl:backup)
        self.detect_direction()

        self.items: List[SyncItem] = []
        self.stats = SyncStats()
        self.current_item: Optional[SyncItem] = None
        self.global_action: Optional[ConflictAction] = None
        self.running = False
        self.backup_dir = self.local_path / ".fzrclone_backups"
        self.history_file = self.local_path / ".fzrclone_history.json"
        self.deleted_files: List[str] = []

    def detect_direction(self) -> None:
        """Detecta quem é remote pelo ':' no path"""
        source_is_remote = ":" in self.source_arg and not self.source_arg.startswith("/")
        dest_is_remote = ":" in self.dest_arg and not self.dest_arg.startswith("/")

        if source_is_remote and dest_is_remote:
            console.print("[red]Erro: Ambos source e dest são remotes. Um deve ser local.[/red]")
            sys.exit(1)

        if not source_is_remote and not dest_is_remote:
            console.print("[red]Erro: Nenhum remote detectado. Use ':' (ex: gdriverl:path)[/red]")
            console.print("[dim]Para sync local-local, use fzrsync.[/dim]")
            sys.exit(1)

        if dest_is_remote:
            # PUSH: local → remote
            self.direction = "push"
            self.local_path = Path(self.source_arg).resolve()
            self.remote_path = self.dest_arg
        else:
            # PULL: remote → local
            self.direction = "pull"
            self.remote_path = self.source_arg
            self.local_path = Path(self.dest_arg).resolve()

    # ========================================================================
    # RCLONE HELPERS
    # ========================================================================

    def rclone_lsjson(self, remote_path: str, recursive: bool = True) -> List[Dict]:
        """Lista arquivos do remote via rclone lsjson"""
        cmd = ["rclone", "lsjson", remote_path]
        if recursive:
            cmd.append("--recursive")
        try:
            result = subprocess.run(
                cmd, capture_output=True, text=True, check=True, timeout=300
            )
            return json.loads(result.stdout) if result.stdout.strip() else []
        except subprocess.CalledProcessError as e:
            if "directory not found" in (e.stderr or ""):
                return []  # Remote path não existe ainda
            console.print(f"[red]Erro rclone lsjson: {e.stderr}[/red]")
            return []
        except subprocess.TimeoutExpired:
            console.print("[red]Timeout ao listar remote (5 min)[/red]")
            return []

    def rclone_copyto(self, src: str, dst: str) -> bool:
        """Copia um arquivo via rclone copyto"""
        cmd = ["rclone", "copyto", src, dst]
        if self.bwlimit:
            cmd.extend(["--bwlimit", self.bwlimit])
        try:
            subprocess.run(cmd, capture_output=True, text=True, check=True, timeout=600)
            return True
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            return False

    def rclone_deletefile(self, path: str) -> bool:
        """Deleta um arquivo do remote"""
        try:
            subprocess.run(
                ["rclone", "deletefile", path],
                capture_output=True, text=True, check=True, timeout=60
            )
            return True
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            return False

    def rclone_mkdir(self, path: str) -> bool:
        """Cria diretório no remote"""
        try:
            subprocess.run(
                ["rclone", "mkdir", path],
                capture_output=True, text=True, check=True, timeout=30
            )
            return True
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            return False

    # ========================================================================
    # FILE INFO
    # ========================================================================

    def get_file_info(self, filepath: Path) -> Optional[FileInfo]:
        """Obtém informações de arquivo local"""
        try:
            stat = filepath.stat()
            return FileInfo(
                path=str(filepath),
                size=stat.st_size if not filepath.is_dir() else 0,
                mtime=stat.st_mtime,
                is_dir=filepath.is_dir()
            )
        except:
            return None

    def remote_entry_to_fileinfo(self, entry: Dict, base_remote: str) -> FileInfo:
        """Converte entrada rclone lsjson em FileInfo"""
        mod_time = entry.get("ModTime", "")
        try:
            dt = datetime.fromisoformat(mod_time.replace("Z", "+00:00"))
            mtime = dt.timestamp()
        except:
            mtime = 0.0

        return FileInfo(
            path=entry.get("Path", ""),
            size=entry.get("Size", 0),
            mtime=mtime,
            is_dir=entry.get("IsDir", False)
        )

    # ========================================================================
    # SCAN
    # ========================================================================

    def scan_directories(self) -> None:
        """Escaneia origem (local ou remote) e destino (local ou remote)"""
        source_files: Dict[str, FileInfo] = {}
        dest_files: Dict[str, FileInfo] = {}

        if self.direction == "push":
            # Source = local, Dest = remote
            console.print(f"[cyan]Escaneando local: {self.local_path}...[/cyan]")
            if self.local_path.exists():
                for item in self.local_path.rglob("*"):
                    if ".fzrclone" in str(item):
                        continue
                    rel_path = str(item.relative_to(self.local_path))
                    info = self.get_file_info(item)
                    if info:
                        source_files[rel_path] = info

            console.print(f"[cyan]Escaneando remote: {self.remote_path}...[/cyan]")
            entries = self.rclone_lsjson(self.remote_path)
            for entry in entries:
                rel_path = entry.get("Path", "")
                if rel_path:
                    dest_files[rel_path] = self.remote_entry_to_fileinfo(entry, self.remote_path)

        else:
            # Source = remote, Dest = local
            console.print(f"[cyan]Escaneando remote: {self.remote_path}...[/cyan]")
            entries = self.rclone_lsjson(self.remote_path)
            for entry in entries:
                rel_path = entry.get("Path", "")
                if rel_path:
                    source_files[rel_path] = self.remote_entry_to_fileinfo(entry, self.remote_path)

            console.print(f"[cyan]Escaneando local: {self.local_path}...[/cyan]")
            if self.local_path.exists():
                for item in self.local_path.rglob("*"):
                    if ".fzrclone" in str(item):
                        continue
                    rel_path = str(item.relative_to(self.local_path))
                    info = self.get_file_info(item)
                    if info:
                        dest_files[rel_path] = info

        # Combinar listas
        all_paths = set(source_files.keys()) | set(dest_files.keys())

        for rel_path in sorted(all_paths):
            item = SyncItem(
                rel_path=rel_path,
                source=source_files.get(rel_path),
                dest=dest_files.get(rel_path)
            )
            self.items.append(item)

        self.stats.total_files = len(self.items)

    def needs_sync(self, item: SyncItem) -> bool:
        """Verifica se arquivo precisa sincronizar"""
        if not item.source:
            return False
        if not item.dest:
            return True
        if item.source.is_dir or item.dest.is_dir:
            return False

        # Compara tamanho
        if item.source.size != item.dest.size:
            return True
        # Compara mtime com tolerância de 2s (cloud storage)
        if abs(item.source.mtime - item.dest.mtime) > 2:
            return True

        return False

    def has_conflict(self, item: SyncItem) -> bool:
        """Verifica se há conflito"""
        if not item.source or not item.dest:
            return False
        if item.source.is_dir or item.dest.is_dir:
            return False
        return item.source.size != item.dest.size

    def is_orphan(self, item: SyncItem) -> bool:
        """Arquivo existe apenas no destino"""
        return item.source is None and item.dest is not None

    # ========================================================================
    # SYNC OPERATIONS
    # ========================================================================

    def backup_file(self, filepath_or_remote: str) -> Optional[str]:
        """Cria backup do arquivo com timestamp (só local)"""
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

        if self.direction == "pull":
            # Destino é local, backup local
            filepath = Path(filepath_or_remote)
            if not filepath.exists():
                return None
            backup_name = f"{filepath.name}.{timestamp}.bak"
            rel_path = filepath.relative_to(self.local_path)
            backup_path = self.backup_dir / rel_path.parent / backup_name
            backup_path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(filepath, backup_path)
            return str(backup_path)
        else:
            # Destino é remote, backup local do remote não é trivial
            # Fazemos download temporário pra backup
            return None

    def sync_file(self, item: SyncItem) -> bool:
        """Sincroniza um arquivo"""
        if not item.source:
            return False

        if self.dry_run:
            return True

        try:
            if self.direction == "push":
                # Local → Remote
                src = str(self.local_path / item.rel_path)
                remote_sep = "/" if not self.remote_path.endswith(":") and not self.remote_path.endswith("/") else ""
                dst = f"{self.remote_path}{remote_sep}{item.rel_path}"

                if item.source.is_dir:
                    self.rclone_mkdir(dst)
                    return True

                if item.action == ConflictAction.REPLACE_BACKUP and item.dest:
                    # Download do remote pra backup antes de sobrescrever
                    backup_dst = self.backup_dir / item.rel_path
                    backup_dst.parent.mkdir(parents=True, exist_ok=True)
                    self.rclone_copyto(dst, str(backup_dst))

                ok = self.rclone_copyto(src, dst)
                if ok:
                    self.stats.bytes_transferred += item.source.size
                return ok

            else:
                # Remote → Local
                remote_sep = "/" if not self.remote_path.endswith(":") and not self.remote_path.endswith("/") else ""
                src = f"{self.remote_path}{remote_sep}{item.rel_path}"
                dst = self.local_path / item.rel_path

                if item.source.is_dir:
                    dst.mkdir(parents=True, exist_ok=True)
                    return True

                dst.parent.mkdir(parents=True, exist_ok=True)

                if item.action == ConflictAction.REPLACE_BACKUP and dst.exists():
                    self.backup_file(str(dst))

                ok = self.rclone_copyto(src, str(dst))
                if ok:
                    self.stats.bytes_transferred += item.source.size
                return ok

        except Exception as e:
            console.print(f"[red]Erro ao sincronizar {item.rel_path}: {e}[/red]")
            return False

    def delete_orphan_file(self, item: SyncItem) -> bool:
        """Deleta arquivo órfão do destino"""
        if not self.is_orphan(item):
            return False

        try:
            if self.dry_run:
                if not (item.dest and item.dest.is_dir):
                    self.deleted_files.append(item.rel_path)
                return True

            if self.direction == "push":
                # Destino é remote: deletar do remote
                if item.dest and item.dest.is_dir:
                    return True  # rclone limpa dirs vazios

                remote_sep = "/" if not self.remote_path.endswith(":") and not self.remote_path.endswith("/") else ""
                remote_file = f"{self.remote_path}{remote_sep}{item.rel_path}"

                # Backup local antes de deletar remote
                backup_dst = self.backup_dir / item.rel_path
                backup_dst.parent.mkdir(parents=True, exist_ok=True)
                self.rclone_copyto(remote_file, str(backup_dst))

                ok = self.rclone_deletefile(remote_file)
                if ok and item.dest:
                    self.stats.bytes_deleted += item.dest.size
                    self.deleted_files.append(item.rel_path)
                return ok

            else:
                # Destino é local: deletar local
                dest_path = self.local_path / item.rel_path

                if dest_path.is_dir():
                    try:
                        dest_path.rmdir()
                    except OSError:
                        pass
                    return True

                if not dest_path.exists():
                    return False

                file_size = item.dest.size if item.dest else 0

                # Backup antes de deletar
                self.backup_file(str(dest_path))

                dest_path.unlink()
                self.stats.bytes_deleted += file_size
                self.deleted_files.append(item.rel_path)

                # Limpar dirs pais vazios
                self._cleanup_empty_parents(dest_path.parent)
                return True

        except Exception as e:
            console.print(f"[red]Erro ao deletar {item.rel_path}: {e}[/red]")
            return False

    def _cleanup_empty_parents(self, dir_path: Path) -> None:
        """Remove diretórios pais vazios até chegar no local base"""
        try:
            while dir_path != self.local_path and dir_path.exists():
                if ".fzrclone" in str(dir_path):
                    break
                try:
                    dir_path.rmdir()
                    dir_path = dir_path.parent
                except OSError:
                    break
        except Exception:
            pass

    # ========================================================================
    # HISTORY & ROLLBACK
    # ========================================================================

    def save_history(self) -> None:
        """Salva histórico para rollback"""
        history = {
            "timestamp": datetime.now().isoformat(),
            "direction": self.direction,
            "source": self.source_arg,
            "dest": self.dest_arg,
            "local": str(self.local_path),
            "remote": self.remote_path,
            "items": [
                {
                    "rel_path": item.rel_path,
                    "action": item.action.name if item.action else None,
                    "status": item.status.name
                }
                for item in self.items if item.status == FileStatus.DONE
            ]
        }

        try:
            self.history_file.parent.mkdir(parents=True, exist_ok=True)
            with open(self.history_file, 'w') as f:
                json.dump(history, f, indent=2)
        except:
            pass

    def do_rollback(self, target: str = "all") -> None:
        """Executa rollback dos arquivos (só local)"""
        if not self.backup_dir.exists():
            console.print("[yellow]Nenhum backup encontrado para rollback[/yellow]")
            return

        console.print(f"[cyan]Executando rollback: {target}[/cyan]")

        for backup_file in self.backup_dir.rglob("*.bak"):
            original_name = backup_file.name.rsplit('.', 2)[0]
            rel_dir = backup_file.parent.relative_to(self.backup_dir)
            original_path = self.local_path / rel_dir / original_name

            if target != "all" and str(original_path) != target:
                continue

            try:
                shutil.copy2(backup_file, original_path)
                console.print(f"[green]Restaurado: {original_path}[/green]")
            except Exception as e:
                console.print(f"[red]Erro ao restaurar {original_path}: {e}[/red]")

    # ========================================================================
    # DASHBOARD TUI (Compacto - idêntico fzrsync)
    # ========================================================================

    def make_compact_status(self) -> Text:
        """Cria linha de status compacta"""
        text = Text()

        if self.stats.total_files > 0:
            processed = self.stats.synced + self.stats.skipped + self.stats.deleted + self.stats.errors
            progress = processed / self.stats.total_files * 100
            bar_width = 30
            filled = int(bar_width * progress / 100)
            bar = "█" * filled + "░" * (bar_width - filled)
            text.append(f"[{bar}] {progress:5.1f}% ", style="green")

        text.append(f"✓{self.stats.synced}", style="green")
        text.append(" | ")
        text.append(f"⏭{self.stats.skipped}", style="yellow")
        if self.delete_dst:
            text.append(" | ")
            text.append(f"🗑{self.stats.deleted}", style="red")
        if self.stats.conflicts > 0:
            text.append(" | ")
            text.append(f"⚠{self.stats.conflicts}", style="orange1")
        if self.stats.errors > 0:
            text.append(" | ")
            text.append(f"✗{self.stats.errors}", style="red")
        text.append(f" | ↕{self.stats.bytes_transferred_human}", style="cyan")
        text.append(f" | ⏱{self.stats.elapsed}", style="dim")

        return text

    def make_current_line(self) -> Text:
        """Linha do arquivo atual sendo processado"""
        text = Text()
        if self.current_item:
            text.append(f"{self.current_item.status.value} ", style="bold")
            path = self.current_item.rel_path
            max_len = 60
            if len(path) > max_len:
                path = "..." + path[-(max_len-3):]
            text.append(path, style="white")
            if self.current_item.source and not self.current_item.source.is_dir:
                text.append(f" ({self.current_item.source.size_human})", style="dim")
        else:
            text.append("Aguardando...", style="dim")
        return text

    def ask_conflict(self, item: SyncItem) -> ConflictAction:
        """Pergunta ao usuário sobre conflito"""
        if self.global_action:
            return self.global_action

        if self.replace_all:
            return ConflictAction.REPLACE

        console.print(f"\n[yellow]⚠️  Conflito detectado: {item.rel_path}[/yellow]")
        console.print(f"   Origem:  {item.source.size_human} - {item.source.mtime_str}")
        console.print(f"   Destino: {item.dest.size_human} - {item.dest.mtime_str}")

        choices = {
            "1": ("Manter antigo (não sincronizar)", ConflictAction.KEEP_OLD),
            "2": ("Substituir pelo novo", ConflictAction.REPLACE),
            "3": ("Substituir mantendo backup", ConflictAction.REPLACE_BACKUP),
            "4": ("Pular", ConflictAction.SKIP),
        }

        console.print("\nOpções:")
        for key, (desc, _) in choices.items():
            console.print(f"  [{key}] {desc}")
        console.print("  [A] Aplicar para todos os conflitos")

        while True:
            choice = Prompt.ask("Escolha", default="3")

            if choice.upper() == "A":
                sub_choice = Prompt.ask("Qual ação para todos?", choices=["1", "2", "3", "4"], default="3")
                self.global_action = choices[sub_choice][1]
                return self.global_action

            if choice in choices:
                return choices[choice][1]

            console.print("[red]Opção inválida[/red]")

    def make_dashboard_panel(self) -> Panel:
        """Cria painel compacto do dashboard"""
        from rich.console import Group

        header = Text()
        header.append("fzrclone", style="bold blue")

        if self.direction == "push":
            header.append(f"  ⬆️  {self.local_path.name}", style="magenta")
            header.append(" → ", style="dim")
            header.append(f"{self.remote_path}", style="green")
        else:
            header.append(f"  ⬇️  {self.remote_path}", style="magenta")
            header.append(" → ", style="dim")
            header.append(f"{self.local_path.name}", style="green")

        if self.dry_run:
            header.append("  [DRY-RUN]", style="bold yellow")
        if self.delete_dst:
            header.append("  [DELETE]", style="bold red")

        status_line = self.make_compact_status()
        current_line = self.make_current_line()

        content = Group(header, Text(""), status_line, current_line)
        return Panel(content, border_style="blue", padding=(0, 1))

    def run_with_dashboard(self) -> None:
        """Executa com dashboard TUI compacto"""
        with Live(self.make_dashboard_panel(), refresh_per_second=4, console=console) as live:
            for item in self.items:
                self.current_item = item
                self.process_item(item)
                live.update(self.make_dashboard_panel())

    def run_silent(self) -> None:
        """Executa sem dashboard"""
        with Progress(
            SpinnerColumn(),
            TextColumn("[progress.description]{task.description}"),
            BarColumn(),
            TextColumn("[progress.percentage]{task.percentage:>3.0f}%"),
            TimeElapsedColumn(),
            console=console
        ) as progress:
            task = progress.add_task("Sincronizando...", total=len(self.items))

            for item in self.items:
                self.process_item(item)
                progress.advance(task)

    def process_item(self, item: SyncItem) -> None:
        """Processa um item"""
        item.status = FileStatus.SYNCING

        # Arquivo órfão (só no destino)
        if self.is_orphan(item):
            if self.delete_dst:
                item.status = FileStatus.DELETING
                if self.delete_orphan_file(item):
                    item.status = FileStatus.DELETED
                    self.stats.deleted += 1
                else:
                    item.status = FileStatus.ERROR
                    self.stats.errors += 1
            else:
                item.status = FileStatus.SKIPPED
                self.stats.skipped += 1
            return

        if not self.needs_sync(item):
            item.status = FileStatus.SKIPPED
            self.stats.skipped += 1
            return

        # Conflito
        if self.has_conflict(item):
            item.status = FileStatus.CONFLICT
            self.stats.conflicts += 1

            if not self.silent:
                action = self.ask_conflict(item)
                item.action = action

                if action in (ConflictAction.KEEP_OLD, ConflictAction.SKIP):
                    item.status = FileStatus.SKIPPED
                    return
            else:
                item.action = ConflictAction.REPLACE_BACKUP
        else:
            item.action = ConflictAction.REPLACE

        # Sincronizar
        if self.sync_file(item):
            item.status = FileStatus.DONE
            self.stats.synced += 1
        else:
            item.status = FileStatus.ERROR
            self.stats.errors += 1

    # ========================================================================
    # SCHEDULE
    # ========================================================================

    def run_scheduled(self) -> None:
        """Executa em modo agendado"""
        if self.schedule == -1:
            console.print("\n[cyan]Configuração de Agendamento[/cyan]")
            freq = Prompt.ask(
                "Frequência",
                choices=["hourly", "daily", "weekly"],
                default="daily"
            )
            hour = int(Prompt.ask("Hora de execução (0-23)", default="18"))
        else:
            freq = "daily"
            hour = self.schedule

        console.print(f"[green]Agendado: {freq} às {hour}:00[/green]")
        self.create_schedule(freq, hour)

    def create_schedule(self, freq: str, hour: int) -> None:
        """Cria agendamento no sistema"""
        script_path = Path(__file__).resolve()
        cmd = f"{sys.executable} {script_path} '{self.source_arg}' '{self.dest_arg}' --silent --replace"

        cron_map = {
            "hourly": f"0 * * * * {cmd}",
            "daily": f"0 {hour} * * * {cmd}",
            "weekly": f"0 {hour} * * 0 {cmd}"
        }

        cron_line = cron_map[freq]

        console.print(f"\n[yellow]Adicione ao crontab:[/yellow]")
        console.print(f"[white]{cron_line}[/white]")

        if Confirm.ask("Adicionar automaticamente ao crontab?"):
            try:
                result = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
                current = result.stdout if result.returncode == 0 else ""
                new_cron = current.rstrip() + "\n" + cron_line + "\n"
                process = subprocess.Popen(["crontab", "-"], stdin=subprocess.PIPE, text=True)
                process.communicate(input=new_cron)
                console.print("[green]✓ Agendamento criado com sucesso![/green]")
            except Exception as e:
                console.print(f"[red]Erro ao criar agendamento: {e}[/red]")

    # ========================================================================
    # SUMMARY
    # ========================================================================

    def print_summary(self) -> None:
        """Imprime resumo final"""
        console.print("\n")

        direction_label = "⬆️  PUSH (local → remote)" if self.direction == "push" else "⬇️  PULL (remote → local)"

        table = Table(title="📋 Resumo da Sincronização", box=box.ROUNDED)
        table.add_column("Métrica", style="cyan")
        table.add_column("Valor", style="white")

        table.add_row("Direção", direction_label)
        table.add_row("Origem", self.source_arg)
        table.add_row("Destino", self.dest_arg)
        table.add_row("Total de arquivos", str(self.stats.total_files))
        table.add_row("Sincronizados", f"[green]{self.stats.synced}[/green]")
        table.add_row("Pulados", f"[yellow]{self.stats.skipped}[/yellow]")
        table.add_row("Conflitos", f"[orange1]{self.stats.conflicts}[/orange1]")
        if self.delete_dst:
            table.add_row("Deletados", f"[red]{self.stats.deleted}[/red] ({self.stats.bytes_deleted_human})")
        table.add_row("Erros", f"[red]{self.stats.errors}[/red]")
        table.add_row("Transferido", f"[cyan]{self.stats.bytes_transferred_human}[/cyan]")
        table.add_row("Tempo total", self.stats.elapsed)

        if self.dry_run:
            table.add_row("Modo", "[yellow]DRY-RUN (nenhuma alteração feita)[/yellow]")
        if self.delete_dst:
            table.add_row("Modo Delete", "[red]--delete-dst ATIVO (órfãos removidos)[/red]")

        console.print(table)

        if self.delete_dst and self.deleted_files:
            del_table = Table(title="🗑️ Arquivos Deletados", box=box.SIMPLE)
            del_table.add_column("Arquivo", style="red")
            for f in self.deleted_files[-20:]:
                del_table.add_row(f)
            if len(self.deleted_files) > 20:
                del_table.add_row(f"... e mais {len(self.deleted_files) - 20} arquivos")
            console.print(del_table)

    # ========================================================================
    # RUN
    # ========================================================================

    def run(self) -> None:
        """Executa sincronização"""
        # Rollback mode
        if self.rollback:
            self.do_rollback(self.rollback)
            return

        # Schedule mode
        if self.schedule is not None:
            self.run_scheduled()
            return

        # Validações
        if self.direction == "push" and not self.local_path.exists():
            console.print(f"[red]Erro: Origem local não existe: {self.local_path}[/red]")
            return

        if self.direction == "pull":
            self.local_path.mkdir(parents=True, exist_ok=True)

        console.print(f"[cyan]Escaneando diretórios...[/cyan]")
        self.scan_directories()
        console.print(f"[green]Encontrados {len(self.items)} itens[/green]")

        if len(self.items) == 0:
            console.print("[yellow]Nada para sincronizar.[/yellow]")
            return

        self.stats.start_time = time.time()
        self.running = True

        if self.silent:
            self.run_silent()
        else:
            self.run_with_dashboard()

        self.save_history()
        self.print_summary()


# ============================================================================
# CLI
# ============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="fzrclone - Rclone Inteligente com Dashboard TUI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Exemplos:
  fzrclone /origem gdriverl:destino              # Push local → remote
  fzrclone gdriverl:origem /destino              # Pull remote → local
  fzrclone --dry-run . gdriverl:backup           # Simular sem alterar
  fzrclone --silent . gdriverl:backup            # Sem dashboard
  fzrclone --replace . gdriverl:backup           # Substituir todos
  fzrclone --delete-dst . gdriverl:backup        # Deletar órfãos no destino
  fzrclone -d -n . gdriverl:backup               # Simular deleção de órfãos
  fzrclone --rollback all . gdriverl:backup      # Reverter todas alterações
  fzrclone --schedule 18 . gdriverl:backup       # Agendar para 18h

Detecção de direção:
  O remote é detectado automaticamente pelo ':' no path.
  Se destino tem ':' → PUSH (local → remote)
  Se origem tem ':' → PULL (remote → local)

Comportamento --delete-dst:
  Se origem tem: A, B, C
  E destino tem: A, B, C, D
  Com --delete-dst: D será deletado (backup criado antes)
  Sem --delete-dst: D será mantido (comportamento padrão)
        """
    )

    parser.add_argument("source", nargs="?", help="Origem (local ou remote:path)")
    parser.add_argument("dest", nargs="?", help="Destino (local ou remote:path)")

    parser.add_argument(
        "--dry-run", "-n",
        action="store_true",
        help="Simular sem fazer alterações"
    )

    parser.add_argument(
        "--silent", "-s",
        action="store_true",
        help="Executar sem dashboard (modo silencioso)"
    )

    parser.add_argument(
        "--replace", "-r",
        action="store_true",
        help="Substituir todos os arquivos no destino"
    )

    parser.add_argument(
        "--rollback",
        nargs="?",
        const="all",
        metavar="ARQUIVO",
        help="Reverter alterações (all = todos, ou caminho específico)"
    )

    parser.add_argument(
        "--schedule",
        nargs="?",
        const=-1,
        type=int,
        metavar="HORA",
        help="Agendar execução (sem parâmetro = configurar, ou hora 0-23)"
    )

    parser.add_argument(
        "--delete-dst", "-d",
        action="store_true",
        help="Deletar arquivos órfãos no destino (que não existem na origem)"
    )

    parser.add_argument(
        "--bwlimit", "-b",
        metavar="LIMIT",
        help="Limitar bandwidth (ex: 1M, 500k)"
    )

    parser.add_argument(
        "--version", "-v",
        action="version",
        version="fzrclone 1.1.0"
    )

    args = parser.parse_args()

    # Banner
    console.print(Panel.fit(
        "[bold blue]fzrclone[/bold blue] [cyan]v1.1.0[/cyan]\n"
        "[dim]Rclone Inteligente com Dashboard TUI[/dim]",
        border_style="blue"
    ))

    # Verificar rclone
    try:
        subprocess.run(["rclone", "version"], capture_output=True, check=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        console.print("[red]Erro: rclone não está instalado[/red]")
        return

    # Validar argumentos
    if not args.source and not args.rollback:
        parser.print_help()
        return

    if args.source and not args.dest:
        console.print("[red]Erro: Destino não especificado[/red]")
        return

    # Criar instância e executar
    rclone = FzRclone(
        source=args.source or ".",
        dest=args.dest or ".",
        dry_run=args.dry_run,
        silent=args.silent,
        replace_all=args.replace,
        rollback=args.rollback,
        schedule=args.schedule,
        delete_dst=args.delete_dst,
        bwlimit=args.bwlimit
    )

    try:
        rclone.run()
    except KeyboardInterrupt:
        console.print("\n[yellow]Operação cancelada pelo usuário[/yellow]")
        rclone.print_summary()


if __name__ == "__main__":
    main()
