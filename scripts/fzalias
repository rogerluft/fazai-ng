#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2155
set -euo pipefail

# =============================================================================
# fzalias - Sistema Global de Alias Multi-Distribuição
# =============================================================================
# Parte do Terminal FazAI
# Repositório: https://github.com/rogerluft/fazai-ng
# Autor: Roger Luft (@rogerluft)
# Licença: MIT
# 
# Descrição:
#   Gerenciador de aliases bash persistentes e globais que funciona em
#   Debian/Ubuntu e RedHat/CentOS/Fedora. Aliases são salvos em 
#   /etc/fazai/fzalias e disponibilizados automaticamente para todos usuários.
#
# Uso:
#   sudo fzalias install    - Instala o sistema de aliases
#   sudo fzalias uninstall  - Remove completamente
#   fzalias [nome] [cmd]    - Cria alias (após instalação)
#   fzalias --help          - Ajuda
# =============================================================================

readonly VERSION="1.0.0"
readonly ALIAS_DIR="/etc/fazai"
readonly ALIAS_FILE="$ALIAS_DIR/fzalias"
readonly SCRIPT_NAME="$(basename "$0")"

# Cores ANSI
readonly R="\e[31m" G="\e[32m" Y="\e[33m" B="\e[34m" N="\e[0m"

# Funções de logging
log()  { echo -e "${B}ℹ${N} $*"; }
ok()   { echo -e "${G}✓${N} $*"; }
warn() { echo -e "${Y}⚠${N} $*" >&2; }
err()  { echo -e "${R}✗${N} $*" >&2; exit 1; }

# =============================================================================
# Funções Auxiliares
# =============================================================================

# Detecta distribuição Linux
detect_distro() {
  if [[ ! -f /etc/os-release ]]; then
    warn "Arquivo /etc/os-release não encontrado"
    echo "unknown"
    return 1
  fi
  
  # Ler variáveis sem executar o arquivo (evita conflitos com variáveis readonly)
  local distro_id
  distro_id=$(grep "^ID=" /etc/os-release | cut -d= -f2 | tr -d '"')
  distro_id="${distro_id:-unknown}"
  distro_id="${distro_id:-unknown}"
  
  case "${distro_id}" in
    debian|ubuntu|mint|pop|linuxmint)
      echo "debian"
      ;;
    rhel|centos|fedora|rocky|almalinux|ol)
      echo "redhat"
      ;;
    arch|manjaro)
      echo "arch"
      ;;
    *)
      warn "Distribuição '$ID' não reconhecida"
      echo "unknown"
      return 1
      ;;
  esac
}

# Verifica se comando existe
command_exists() {
  command -v "$1" >/dev/null 2>&1
}

# Verifica se está rodando como root
require_root() {
  if [[ $EUID -ne 0 ]]; then
    err "Este comando requer privilégios root. Execute com sudo."
  fi
}

# Backup seguro de arquivo
backup_file() {
  local file="$1"
  if [[ -f "$file" ]]; then
    local backup="${file}.backup.$(date +%Y%m%d_%H%M%S)"
    cp "$file" "$backup"
    log "Backup criado: $backup"
  fi
}

# =============================================================================
# Instalação
# =============================================================================

install_fzalias() {
  require_root
  
  local distro
  distro=$(detect_distro) || {
    err "Não foi possível detectar a distribuição Linux"
  }
  
  log "Distribuição detectada: $distro"
  
  # Cria diretório com permissões corretas
  if [[ ! -d "$ALIAS_DIR" ]]; then
    mkdir -p "$ALIAS_DIR" || err "Falha ao criar $ALIAS_DIR"
    chmod 755 "$ALIAS_DIR"
    ok "Diretório $ALIAS_DIR criado"
  fi
  
  # Cria arquivo de aliases com a função fzalias
  log "Criando $ALIAS_FILE..."
  cat > "$ALIAS_FILE" <<'EOFALIASFILE'
# =============================================================================
# FazAI Global Aliases - Gerenciado por fzalias
# =============================================================================
# Este arquivo é carregado automaticamente em /etc/profile
# Adicione aliases com: fzalias [nome] [comando]
# =============================================================================

fzalias() {
  if [[ "$1" == "--help" || "$1" == "-h" || -z "${1:-}" ]]; then
    echo "Uso: fzalias [alias] [comando]"
    echo ""
    echo "Exemplos:"
    echo "  fzalias ll 'ls -lah --color=auto'"
    echo "  fzalias update 'sudo apt update && sudo apt upgrade -y'"
    echo ""
    echo "Listar aliases: cat /etc/fazai/fzalias"
    echo "Remover alias:  fzalias-remove [nome]"
    return 0
  fi

  local name="$1"
  shift
  local cmd="$*"

  # Validações
  if [[ -z "$name" ]]; then
    echo "✗ Erro: nome do alias não pode ser vazio" >&2
    return 1
  fi

  if [[ -z "$cmd" ]]; then
    echo "✗ Erro: comando não pode ser vazio" >&2
    return 1
  fi

  # Verifica se é um comando perigoso (básico)
  if [[ "$cmd" =~ rm[[:space:]]+-rf[[:space:]]*/$ ]]; then
    echo "⚠ Aviso: comando potencialmente perigoso detectado!" >&2
    read -rp "Deseja continuar? [y/N]: " confirm
    [[ "$confirm" != [yY] ]] && return 1
  fi

  # Remove alias anterior se existir
  if grep -q "^alias $name=" /etc/fazai/fzalias 2>/dev/null; then
    sed -i "/^alias $name=/d" /etc/fazai/fzalias
    echo "ℹ Alias '$name' existente foi substituído"
  fi

  # Adiciona novo alias
  echo "alias $name='$cmd'" >> /etc/fazai/fzalias
  echo "✓ Alias '$name' criado com sucesso"
  
  # Recarrega aliases na sessão atual
  # shellcheck disable=SC1090
  source /etc/fazai/fzalias
}

# Função auxiliar para remover aliases
fzalias-remove() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Uso: fzalias-remove [alias]"
    return 1
  fi
  
  if sed -i "/^alias $name=/d" /etc/fazai/fzalias 2>/dev/null; then
    echo "✓ Alias '$name' removido"
    # shellcheck disable=SC1090
    source /etc/fazai/fzalias
    unalias "$name" 2>/dev/null || true
  else
    echo "✗ Alias '$name' não encontrado"
    return 1
  fi
}

# Função para listar aliases
fzalias-list() {
  if [[ -f /etc/fazai/fzalias ]]; then
    grep "^alias " /etc/fazai/fzalias | sed 's/^alias //' | sort
  else
    echo "Nenhum alias configurado"
  fi
}

EOFALIASFILE

  chmod 644 "$ALIAS_FILE"
  ok "Arquivo $ALIAS_FILE criado"
  
  # Integração com /etc/profile (universal)
  if ! grep -qF "source $ALIAS_FILE" /etc/profile 2>/dev/null; then
    backup_file /etc/profile
    cat >> /etc/profile <<EOF

# FazAI Global Aliases
[[ -f $ALIAS_FILE ]] && source $ALIAS_FILE
EOF
    ok "Integrado em /etc/profile"
  else
    warn "/etc/profile já contém referência ao fzalias"
  fi
  
  # Bash config específico por distribuição
  case "$distro" in
    debian)
      if [[ -f /etc/bash.bashrc ]]; then
        if ! grep -qF "source $ALIAS_FILE" /etc/bash.bashrc; then
          backup_file /etc/bash.bashrc
          cat >> /etc/bash.bashrc <<EOF

# FazAI Global Aliases
[[ -f $ALIAS_FILE ]] && source $ALIAS_FILE
EOF
          ok "Integrado em /etc/bash.bashrc"
        else
          warn "/etc/bash.bashrc já contém referência ao fzalias"
        fi
      fi
      ;;
    redhat)
      if [[ -f /etc/bashrc ]]; then
        if ! grep -qF "source $ALIAS_FILE" /etc/bashrc; then
          backup_file /etc/bashrc
          cat >> /etc/bashrc <<EOF

# FazAI Global Aliases
[[ -f $ALIAS_FILE ]] && source $ALIAS_FILE
EOF
          ok "Integrado em /etc/bashrc"
        else
          warn "/etc/bashrc já contém referência ao fzalias"
        fi
      fi
      ;;
  esac
  
  # Bash completion
  local completion_dir
  if [[ -d /usr/share/bash-completion/completions ]]; then
    completion_dir="/usr/share/bash-completion/completions"
  elif [[ -d /etc/bash_completion.d ]]; then
    completion_dir="/etc/bash_completion.d"
  else
    mkdir -p /etc/bash_completion.d
    completion_dir="/etc/bash_completion.d"
  fi
  
  log "Instalando bash completion em $completion_dir..."
  cat > "$completion_dir/fzalias" <<'EOFCOMPLETION'
# FazAI fzalias bash completion

_fzalias_completions() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  
  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=($(compgen -W "--help -h" -- "$cur"))
  fi
}

_fzalias_remove_completions() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local aliases
  
  if [[ -f /etc/fazai/fzalias ]]; then
    aliases=$(grep "^alias " /etc/fazai/fzalias | sed 's/^alias \([^=]*\)=.*/\1/')
    COMPREPLY=($(compgen -W "$aliases" -- "$cur"))
  fi
}

complete -F _fzalias_completions fzalias
complete -F _fzalias_remove_completions fzalias-remove
EOFCOMPLETION
  
  chmod 644 "$completion_dir/fzalias"
  ok "Bash completion instalado"
  
  echo ""
  ok "fzalias instalado com sucesso! ($distro)"
  echo ""
  echo "Para começar a usar:"
  echo "  1. Reinicie seu shell ou execute: source $ALIAS_FILE"
  echo "  2. Crie aliases com: fzalias [nome] [comando]"
  echo "  3. Liste aliases com: fzalias-list"
  echo ""
}

# =============================================================================
# Desinstalação
# =============================================================================

uninstall_fzalias() {
  require_root
  
  log "Removendo fzalias..."
  
  # Remove arquivo de aliases
  if [[ -f "$ALIAS_FILE" ]]; then
    rm -f "$ALIAS_FILE"
    ok "Arquivo $ALIAS_FILE removido"
  fi
  
  # Remove diretório se estiver vazio
  if [[ -d "$ALIAS_DIR" ]]; then
    rmdir "$ALIAS_DIR" 2>/dev/null && ok "Diretório $ALIAS_DIR removido" || true
  fi
  
  # Remove de /etc/profile
  if [[ -f /etc/profile ]]; then
    backup_file /etc/profile
    sed -i "\|# FazAI Global Aliases|d" /etc/profile
    sed -i "\|\[[ -f $ALIAS_FILE \]\] && source $ALIAS_FILE|d" /etc/profile
    sed -i "\|source $ALIAS_FILE|d" /etc/profile
    ok "Removido de /etc/profile"
  fi
  
  # Remove de /etc/bash.bashrc (Debian)
  if [[ -f /etc/bash.bashrc ]]; then
    backup_file /etc/bash.bashrc
    sed -i "\|# FazAI Global Aliases|d" /etc/bash.bashrc
    sed -i "\|\[[ -f $ALIAS_FILE \]\] && source $ALIAS_FILE|d" /etc/bash.bashrc
    sed -i "\|source $ALIAS_FILE|d" /etc/bash.bashrc
    ok "Removido de /etc/bash.bashrc"
  fi
  
  # Remove de /etc/bashrc (RedHat)
  if [[ -f /etc/bashrc ]]; then
    backup_file /etc/bashrc
    sed -i "\|# FazAI Global Aliases|d" /etc/bashrc
    sed -i "\|\[[ -f $ALIAS_FILE \]\] && source $ALIAS_FILE|d" /etc/bashrc
    sed -i "\|source $ALIAS_FILE|d" /etc/bashrc
    ok "Removido de /etc/bashrc"
  fi
  
  # Remove bash completion
  local completion_files=(
    "/usr/share/bash-completion/completions/fzalias"
    "/etc/bash_completion.d/fzalias"
  )
  
  for file in "${completion_files[@]}"; do
    if [[ -f "$file" ]]; then
      rm -f "$file"
      ok "Completion removido: $file"
    fi
  done
  
  echo ""
  ok "fzalias removido completamente!"
  echo ""
  echo "Para aplicar as mudanças:"
  echo "  - Reinicie seu shell ou execute: exec bash"
  echo "  - Ou faça logout e login novamente"
  echo ""
}

# =============================================================================
# Exibir ajuda
# =============================================================================

show_help() {
  cat <<EOF
fzalias v$VERSION - Sistema Global de Alias Multi-Distribuição

Uso: $SCRIPT_NAME [comando]

Comandos:
  install         Instala o sistema de aliases globais
  uninstall       Remove completamente o sistema
  version         Exibe a versão
  help            Exibe esta ajuda

Após instalação:
  fzalias [nome] [comando]      Cria um novo alias global
  fzalias-remove [nome]         Remove um alias
  fzalias-list                  Lista todos os aliases

Exemplos:
  sudo $SCRIPT_NAME install
  fzalias ll 'ls -lah --color=auto'
  fzalias update 'sudo apt update && sudo apt upgrade -y'
  fzalias-list
  fzalias-remove ll

Documentação: https://github.com/rogerluft/fazai-ng
EOF
}

# =============================================================================
# Main
# =============================================================================

main() {
  case "${1:-}" in
    install)
      install_fzalias
      ;;
    uninstall|remove)
      uninstall_fzalias
      ;;
    version|--version|-v)
      echo "fzalias v$VERSION"
      ;;
    help|--help|-h)
      show_help
      ;;
    *)
      err "Comando inválido: ${1:-}

Use: $SCRIPT_NAME {install|uninstall|version|help}"
      ;;
  esac
}

main "$@"
