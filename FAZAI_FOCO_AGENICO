### OUTPUT_STRUCTURE
```typescript
interface DecomposedTask {
  originalTask: string;
  subtasks: SubTask[];
  executionPlan: string;
}

interface SubTask {
  id: string;                    // "task-1", "task-2"
  description: string;           // Human-readable
  command: string | null;        // Exact Linux command
  dependencies: string[];        // ["task-1"] means execute after task-1
  estimatedComplexity: number;   // 1-10
  requiresInstallation: boolean;
  installCommand?: string;       // "apt-get install -y ..."
  verificationCommand?: string;  // "which ss || which netstat"
}
```

