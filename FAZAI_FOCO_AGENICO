### HOP_ALGORITHM_TYPESCRIPT
```typescript
// Conceptual implementation of ECOA block composition
interface ExecutionBlock {
  id: string;
  content: string;  // The actual commands/scripts
  verified: boolean;
  
  // Backward-looking (where it came from)
  source_context: string;
  legitimate_contexts: Set<string>;
  
  // Forward-looking (where it can go) - ECOA INNOVATION
  valid_destinations: string[];  // Pattern-based: "deploy_*", "setup_web_*"
  destination_hints: Array<{ concept: string; relevance: number }>;
  
  // Temporal
  created_at: Date;
  last_success: Date;
  use_count: number;
  success_count: number;
}

// Block composition for a new task
async function composeTask(task: string): Promise<CompositionResult> {
  const subtasks = await decomposeTask(task);
  const composition: CompositionResult = { blocks: [], gaps: [] };
  
  for (const subtask of subtasks) {
    // Try to find existing block via destination index
    const block = await findBlockForSubtask(subtask);
    
    if (block && canHop(block, subtask.context)) {
      // REUSE existing block - no LLM needed!
      composition.blocks.push({ subtask, block, source: 'reused' });
      await recordSuccessfulHop(block, subtask.context);
    } else {
      // Need to execute new subtask
      composition.gaps.push(subtask);
    }
  }
  
  return composition;
}

// Check if block can hop to target destination
function canHop(block: ExecutionBlock, targetContext: string): boolean {
  // Check pattern-based destinations
  for (const pattern of block.valid_destinations) {
    if (matchesPattern(targetContext, pattern)) {
      return true;
    }
  }
  
  // Fallback to legitimate_contexts (backward compatibility)
  return block.legitimate_contexts.has(targetContext) ||
         block.legitimate_contexts.has("*");
}

// QUANTUM: Find block via destination index - O(1), NO SIMILARITY
function findBlockForSubtask(subtask: Subtask): ExecutionBlock | null {
  const concepts = extractConcepts(subtask.description);
  
  // Hashmap lookups only - no embedding, no cosine
  let candidates: Set<string> | null = null;
  for (const concept of concepts) {
    const blockIds = destinationIndex.get(concept);
    if (!blockIds) continue;
    
    if (candidates === null) {
      candidates = new Set(blockIds);
    } else {
      candidates = intersect(candidates, blockIds);
    }
  }
  
  if (!candidates || candidates.size === 0) return null;
  
  // Return best match by success rate
  return getBestBlock(candidates);
}
```

### AFTER_SUCCESSFUL_EXECUTION
```typescript
// When a new subtask executes successfully, create a reusable block
async function saveExecutionBlock(
  subtask: Subtask,
  result: ExecutionResult
): Promise<ExecutionBlock> {
  // Generate forward-looking destinations via LLM
  const destinations = await generateDestinations(subtask, result);
  
  const block: ExecutionBlock = {
    id: generateBlockId(),
    content: subtask.command,
    verified: result.success,
    source_context: subtask.context,
    legitimate_contexts: new Set([subtask.context]),
    
    // ECOA innovation: where can this block GO?
    valid_destinations: destinations.patterns,     // ["deploy_*", "setup_*"]
    destination_hints: destinations.hints,         // [{concept: "nginx", relevance: 0.9}]
    
    created_at: new Date(),
    last_success: new Date(),
    use_count: 1,
    success_count: 1
  };
  
  // Save to Qdrant
  await saveBlock(block);
  
  // Self-index into destination index for O(1) lookup
  await indexBlockDestinations(block);
  
  return block;
}

// Self-indexing into destination index
async function indexBlockDestinations(block: ExecutionBlock): Promise<void> {
  for (const hint of block.destination_hints) {
    // Add block to destination index for this concept
    const existing = destinationIndex.get(hint.concept) || new Set();
    existing.add(block.id);
    destinationIndex.set(hint.concept, existing);
  }
}
